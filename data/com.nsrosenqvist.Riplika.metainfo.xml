<?xml version="1.0" encoding="UTF-8"?>
<!--
  What a software centre shows about Riplika.

  Required to appear on Flathub, and worth having without it: a bundle
  installed by hand carries this too, and without it the application shows up
  with no name, no description and no licence beside it.

  The summary and description are the same claims the README makes, kept
  short enough to read in a list.
-->
<component type="desktop-application">
  <id>com.nsrosenqvist.Riplika</id>

  <name>Riplika</name>
  <summary>Turn discs into a tagged library</summary>

  <!-- The text here, not the program it describes. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="com.nsrosenqvist">
    <name>Niklas Rosenqvist</name>
  </developer>

  <description>
    <p>
      Riplika reads a disc and writes files a media server can use, with the
      naming and tagging already done. It asks the drive what kind of disc it
      is holding and reads it accordingly.
    </p>
    <p>
      A DVD becomes encoded video whose subtitles have been turned from
      pictures into text, named from a catalogue that is checked against the
      structure of the disc itself. A music CD becomes FLAC or MP3, tagged and
      with its cover art, identified by the disc id its table of contents
      produces. A game disc is copied whole at the full sector size a
      preservation database expects, then checked against Redump datfiles.
    </p>
    <p>
      A damaged disc is reported as damaged, and no file is left looking
      finished when it is not. Audio is checked against the drive's own error
      pointers, and data sectors against the error detection written inside
      them.
    </p>
  </description>

  <launchable type="desktop-id">com.nsrosenqvist.Riplika.desktop</launchable>

  <url type="homepage">https://github.com/nsrosenqvist/riplika</url>
  <url type="bugtracker">https://github.com/nsrosenqvist/riplika/issues</url>
  <url type="vcs-browser">https://github.com/nsrosenqvist/riplika</url>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>

  <keywords>
    <keyword>DVD</keyword>
    <keyword>CD</keyword>
    <keyword>rip</keyword>
    <keyword>subtitles</keyword>
    <keyword>transcode</keyword>
  </keywords>

  <!--
    The URL has to be a direct link, and from a tag rather than a branch,
    since a branch moves and Flathub keeps what it fetched. ./release.sh
    rewrites these to the tag it is making, so they cannot fall behind it.
  -->
  <screenshots>
    <screenshot type="default">
      <caption>A disc in the drive, waiting to be read</caption>
      <image>https://raw.githubusercontent.com/nsrosenqvist/riplika/v0.2.0/data/screenshots/drive.png</image>
    </screenshot>
    <screenshot>
      <caption>What the disc turned out to be, and the reasons for thinking so</caption>
      <image>https://raw.githubusercontent.com/nsrosenqvist/riplika/v0.2.0/data/screenshots/identify.png</image>
    </screenshot>
    <screenshot>
      <caption>Quality, languages, and what to take from the disc</caption>
      <image>https://raw.githubusercontent.com/nsrosenqvist/riplika/v0.2.0/data/screenshots/settings.png</image>
    </screenshot>
    <screenshot>
      <caption>Ripping, with the episodes it worked out listed underneath</caption>
      <image>https://raw.githubusercontent.com/nsrosenqvist/riplika/v0.2.0/data/screenshots/ripping.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#a5d8ff</color>
    <color type="primary" scheme_preference="dark">#1c4966</color>
  </branding>

  <releases>
    <release version="0.2.0" date="2026-08-28">
      <description>
        <p>
          Music CDs and game discs alongside video, each identified and
          verified in the way that suits it.
        </p>
      </description>
    </release>
  </releases>
</component>
